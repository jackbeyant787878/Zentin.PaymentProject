{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=ZentinPayment;Integrated Security=true;TrustServerCertificate=true",
    "Redis": "localhost:6379"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": "5672",
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/"
  },
  "Cap": {
    "GroupName": "zentin-manager",
    "ExchangeName": "zentin.cap",
    "FailedRetryCount": 5
  },
  "ConsulConfig": {
    "RegistryAddress": "",
    "ServiceName": "zentin-manager-api",
    "ServiceIP": "127.0.0.1",
    "ServicePort": "5010"
  },
  "Resilience": {
    "MaxRetryAttempts": 3,
    "TotalRequestTimeoutSeconds": 30,
    "CircuitBreaker": {
      "FailureRatio": 0.1,
      "MinimumThroughput": 100,
      "SamplingDurationSeconds": 30,
      "BreakDurationSeconds": 5
    }
  }
}